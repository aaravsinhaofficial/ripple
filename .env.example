# Account-free by default. Restart the API after changing configuration.
RIPPLE_MODE=demo
RIPPLE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RIPPLE_DATABASE_PATH=data/ripple.sqlite3

# Provider credentials stay on the private backend. Never use VITE_ prefixes.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
RIPPLE_ENABLE_ULTRA=false
TAVILY_API_KEY=
RIPPLE_ENABLE_TAVILY=false

# Required in live mode. Enter only this app token in the UI connection dialog.
# Generate a random value locally: python -c 'import secrets; print(secrets.token_urlsafe(32))'
RIPPLE_ACCESS_TOKEN=
RIPPLE_RATE_LIMIT=12
RIPPLE_DAILY_LIVE_LIMIT=25
RIPPLE_CONCURRENCY=2
RIPPLE_MAX_COMPLETION_TOKENS=2000
RIPPLE_PROVIDER_TIMEOUT=75

# Built-in SQLite worker by default. For Nebius Jobs, set false on the API,
# then use a DISTINCT private worker token on API and worker.
RIPPLE_INLINE_JOBS=true
RIPPLE_WORKER_TOKEN=
RIPPLE_WORKER_API_URL=
RIPPLE_JOB_RETENTION_HOURS=24

# Optional public URL prefilled in the connection dialog; never put a token here.
VITE_RIPPLE_API_URL=
